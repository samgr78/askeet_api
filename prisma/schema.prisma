// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id    Int     @id @default(autoincrement())
  first_name String
  last_name String
  email String  @unique
  password String
  birth_date DateTime?
  phone String?
  subscription Boolean @default(false)
  pp String

  surveys Survey[]
  group Group[]
  user_group User_Group[]
  user_answer User_Answer[]
}

model Survey {
  id Int @id @default(autoincrement())
  creator User @relation(fields: [creator_id], references: [id])
  creator_id Int
  title String
  img String?
  likes Int @default(0)
  color String
  category Category @relation(fields: [category_id], references: [id])
  category_id Int

  survey_answer Survey_Answer[]
}

model Category{
  id Int @id @default(autoincrement())
  name String

  survey Survey[]
}

model Answer {
  id Int @id @default(autoincrement())
  texte String
  img String

  survey_answer Survey_Answer[]
}

model Survey_Answer{
  id Int @id @default(autoincrement())
  survey Survey @relation(fields: [survey_id], references: [id])
  survey_id Int
  answer Answer @relation(fields: [answer_id], references: [id])
  answer_id Int

  user_group User_Answer[]
  group_answer Group_Answer[]
}

model Group{
  id Int @id @default(autoincrement())
  creator User @relation(fields: [creator_id], references: [id])
  creator_id Int
  title String
  code String?
  lien String?
  is_community Boolean @default(false)

  user_group User_Group[]
  group_answer Group_Answer[]
}

model User_Group{
  id Int @id @default(autoincrement())
  user User @relation(fields: [user_id], references: [id])
  user_id Int
  group Group @relation(fields: [group_id], references: [id])
  group_id Int
}

model User_Answer {
  id Int @id @default(autoincrement())
  survey_answer Survey_Answer @relation(fields: [survey_answer_id], references: [id])
  survey_answer_id Int
  user User @relation(fields: [user_id], references: [id])
  user_id Int

}

model Group_Answer{
  id Int @id @default(autoincrement())
  survey_answer Survey_Answer @relation(fields: [survey_answer_id], references: [id])
  survey_answer_id Int
  group Group @relation(fields: [group_id], references: [id])
  group_id Int
}

model Comment {
  id    Int   @id @default(autoincrement())
}